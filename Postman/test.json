{
	"info": {
		"_postman_id": "d45da4a7-1318-4b4d-8fe4-749a61da572b",
		"name": "AutoTesting",
		"schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json"
	},
	"item": [
		{
			"name": "POST api/v1/users/register Success",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "915377e8-e9f4-4a27-99cd-7dc77db9a646",
						"exec": [
							"pm.test(\"Status is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const response = pm.response.json();",
							"",
							"let requestBody;",
							"try {",
							"    requestBody = JSON.parse(pm.request.body.raw);",
							"} catch (e) {",
							"    console.error(\"Не удалось распарсить тело запроса\");",
							"    requestBody = {};",
							"}",
							"",
							"pm.test(\"Response == Request\", function () {",
							"    pm.expect(response).to.have.property(\"userId\");",
							"    pm.expect(response.login).to.eql(requestBody.login);",
							"    pm.expect(response.email).to.eql(requestBody.email);",
							"    pm.expect(response.phone).to.eql(requestBody.phone);",
							"});",
							"",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"id": "61453846-3486-46b3-a18d-b09e2f33ea2b",
						"exec": [
							"let requestBody = {};",
							"try {",
							"    requestBody = JSON.parse(pm.request.body.raw);",
							"} catch (e) {",
							"    console.error(\"Не удалось распарсить тело запроса, используем пустой объект\");",
							"}",
							"",
							"if (!requestBody.login || !requestBody.password) {",
							"    console.warn(\"В текущем запросе отсутствуют login или password, удаление не будет выполнено\");",
							"} else {",
							"    pm.sendRequest({",
							"        url: `${pm.environment.get(\"baseUrl\")}/api/v1/users/delete`,",
							"        method: 'DELETE',",
							"        header: {",
							"            'Authorization': `Bearer ${pm.environment.get(\"token\")}`,",
							"            'Content-Type': 'application/json'",
							"        },",
							"        body: {",
							"            mode: 'raw',",
							"            raw: JSON.stringify({",
							"                login: requestBody.login,",
							"                password: requestBody.password",
							"            })",
							"        }",
							"    }, (err, res) => {",
							"        if (err) {",
							"            console.error(\"Ошибка при удалении:\", err);",
							"        } else {",
							"            console.log(\"Статус удаления:\", res.status);",
							"        }",
							"    });",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"id": "d2cb284b-fcea-4006-9a7d-33e940935f3d",
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": {
						"token": "{{token}}"
					}
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"login\": \"SlavaBuchnev\",\n    \"email\": \"slavabuchnev5@gmail.com\",\n    \"phone\": \"+79999999999\",\n    \"password\": \"SuperPassword0!\"\n}\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/api/v1/users/register"
			},
			"response": []
		},
		{
			"name": "POST api/v1/users/register Fail because without token",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "16d10e29-f3da-4177-b98a-0dd55ce83596",
						"exec": [
							"pm.test(\"Status is 401\", function () {",
							"    pm.response.to.have.status(401);",
							"});",
							"",
							"const response = pm.response.json();",
							"console.log(response)",
							"",
							"pm.test(\"Request fail\", function () {",
							"    pm.expect(response).to.have.property(\"error\");",
							"    pm.expect(response).to.have.property(\"code\");",
							"    pm.expect(response).to.have.property(\"message\");",
							"    pm.expect(response).to.have.property(\"timestamp\");",
							"    pm.expect(response.error).to.eql(\"Forbidden\");",
							"    pm.expect(response.code).to.eql(\"AUTH\");",
							"    pm.expect(response.message).to.eql(\"Invalid admin token\");",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
